{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "backend/app/**",
          "backend/sources.json",
          "db/**"
        ],
        "excludeFiles": [
          "backend/.venv/**",
          "backend/tests/**",
          "backend/**/__pycache__/**",
          "frontend/**",
          "**/.git/**",
          "**/node_modules/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
