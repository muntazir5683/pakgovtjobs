# Copy to backend/.env and fill in.

# Supabase: Project Settings -> Database -> Connection string (use the *Session* pooler or direct connection,
#           not the transaction pooler, so the crawl advisory lock works).
# Neon: use the direct (non-pooled) connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pakgovjobs

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Free tier allows ~15 requests/min -> set 4.5 if you are not on a paid key.
GEMINI_MIN_INTERVAL_SECONDS=1.0

ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=change-me-too

CORS_ORIGINS=http://localhost:3000

RUN_SCHEDULER=true
CRAWL_INTERVAL_HOURS=6
CRAWL_ON_STARTUP=false
MAX_NEW_PER_SOURCE=15
NO_DEADLINE_EXPIRE_DAYS=45
