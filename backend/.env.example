# Copy to backend/.env and fill in.
# Leave DATABASE_URL empty (or unset) to use a local SQLite file at backend/pakgovjobs.db.

# Neon: Project -> Connection details. Prefer the **direct** (non-pooler) URL for the crawler /
# GitHub Actions so pg_try_advisory_lock works. The Vercel API can use the pooler URL.
# Both postgres:// and postgresql:// are accepted (postgres:// is normalized automatically).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pakgovjobs

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Free tier allows ~15 requests/min -> set 4.5 if you are not on a paid key.
GEMINI_MIN_INTERVAL_SECONDS=1.0

ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=change-me-too

CORS_ORIGINS=http://localhost:3000

# Local/dev only — ignored on Vercel (crawls run from GitHub Actions there).
RUN_SCHEDULER=true
CRAWL_INTERVAL_HOURS=6
CRAWL_ON_STARTUP=false
NO_DEADLINE_EXPIRE_DAYS=45

# Optional on Vercel: let /admin "Run crawler" dispatch .github/workflows/crawl.yml
# GITHUB_TOKEN=<fine-grained PAT with Actions: write>
# GITHUB_REPO=owner/pakgovtjobs
# GITHUB_WORKFLOW=crawl.yml
# GITHUB_REF=main
