# Local development only: URL of the FastAPI backend. Read on the server only (never sent to the browser).
API_URL=http://localhost:8000

# On Vercel leave API_URL UNSET: the backend is deployed in the same project (/api/*) and the frontend
# automatically calls its own deployment. Set it only to point the frontend at an external backend.
# Alternative name that is also accepted (but would be visible in the browser bundle):
# NEXT_PUBLIC_API_URL=
